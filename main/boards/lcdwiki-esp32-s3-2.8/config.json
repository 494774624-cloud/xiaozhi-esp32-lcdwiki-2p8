                "CONFIG_USE_AFE_WAKE_WORD=y",
                "CONFIG_SR_WN_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_HIESP=n",
                "CONFIG_SR_WN_WN9_XIAOBINXIAOBIN_TTS=y",
                "CONFIG_SR_MN_CN_NONE=y"
            ]
        }
    ]
}
